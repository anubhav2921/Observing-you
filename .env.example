# AI Study Focus Monitor — Environment Configuration Example

# Hardware & Inference Device ("auto", "cuda", "cpu")
DEVICE=auto

# Local Camera Device Index (0 = default webcam)
CAMERA_INDEX=0
TARGET_FPS=30

# Web Server Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=false

# Alert & Audio Configuration
AUDIO_ENABLED=true
ALERT_COOLDOWN_SECONDS=15.0
DISTRACTION_ALERT_ENABLED=true
SLEEPINESS_ALERT_ENABLED=true
OCCLUSION_ALERT_ENABLED=true

# Detection Thresholds
YOLO_CONF_THRESHOLD=0.40
DROWSINESS_SUSTAINED_SECS=1.8
PHONE_DETECT_SECS=4.0
INACTIVITY_WARNING_SECS=12.0
FACE_OCCLUDED_SECS=3.5
STUDENT_ABSENT_SECS=6.0

